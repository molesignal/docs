{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MoleSignal Docs",
  "colors": {
    "primary": "#4F60E0",
    "light": "#7682EB",
    "dark": "#3742C7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "en/index",
              "en/quickstart",
              "en/concepts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "en/ingestion",
              "en/query",
              "en/correlation",
              "en/alerting"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "en/deployment",
              "en/configuration",
              "en/security"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "en/api-reference"
            ]
          }
        ]
      },
      {
        "language": "zh",
        "groups": [
          {
            "group": "快速上手",
            "pages": [
              "zh/index",
              "zh/quickstart",
              "zh/concepts"
            ]
          },
          {
            "group": "指南",
            "pages": [
              "zh/ingestion",
              "zh/query",
              "zh/correlation",
              "zh/alerting"
            ]
          },
          {
            "group": "运维",
            "pages": [
              "zh/deployment",
              "zh/configuration",
              "zh/security"
            ]
          },
          {
            "group": "参考",
            "pages": [
              "zh/api-reference"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://molesignal.io",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://molesignal.io/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@molesignal.io"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/molesignal/molesignal",
      "discord": "https://discord.gg/molesignal"
    }
  }
}