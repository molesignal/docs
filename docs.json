{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MoleSignal Docs",
  "colors": {
    "primary": "#4F60E0",
    "light": "#7682EB",
    "dark": "#3742C7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
