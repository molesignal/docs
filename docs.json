{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MoleSignal Docs",
  "colors": {
    "primary": "#4F60E0",
    "light": "#7682EB",
    "dark": "#3742C7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/index",
                  "en/quickstart",
                  "en/concepts"
                ]
              },
              {
                "group": "Guides",
                "pages": [
                  "en/ingestion",
                  "en/query",
                  "en/correlation",
                  "en/alerting"
                ]
              },
              {
                "group": "Operations",
                "pages": [
                  "en/deployment",
                  "en/configuration",
                  "en/security"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "en/api-reference"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "/api-reference/openapi.json",
                  "directory": "en/api"
                }
              }
            ]
          },
          {
            "tab": "Changelog",
            "groups": [
              {
                "group": "Changelog",
                "pages": [
                  "en/changelog"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "文档",
            "groups": [
              {
                "group": "快速上手",
                "pages": [
                  "zh/index",
                  "zh/quickstart",
                  "zh/concepts"
                ]
              },
              {
                "group": "指南",
                "pages": [
                  "zh/ingestion",
                  "zh/query",
                  "zh/correlation",
                  "zh/alerting"
                ]
              },
              {
                "group": "运维",
                "pages": [
                  "zh/deployment",
                  "zh/configuration",
                  "zh/security"
                ]
              }
            ]
          },
          {
            "tab": "API 参考",
            "groups": [
              {
                "group": "概览",
                "pages": [
                  "zh/api-reference"
                ]
              },
              {
                "group": "接口",
                "openapi": {
                  "source": "/api-reference/openapi.json",
                  "directory": "zh/api"
                }
              }
            ]
          },
          {
            "tab": "更新日志",
            "groups": [
              {
                "group": "更新日志",
                "pages": [
                  "zh/changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@molesignal.io"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/molesignal/molesignal",
      "discord": "https://discord.gg/molesignal"
    }
