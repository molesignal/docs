    "/api/v1/query": {
      "post": {
        "summary": "Execute SQL or PromQL query",
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "description": "`application/x-ndjson` 走 streaming（bypass query_result cache）",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "org_id",
                  "language",
                  "statement",
                  "time_range"
                ],
                "properties": {
                  "org_id": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "sql",
                      "promql"
                    ]
                  },
                  "statement": {
                    "type": "string"
                  },
                  "time_range": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer"
                      },
                      "end": {
                        "type": "integer"
                      }
                    }
                  },
                  "stream": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "stream_type": {
                        "type": "string",
                        "enum": [
                          "logs",
                          "metrics",
                          "traces",
                          "enrichment"
                        ]
                      }
                    }
                  },
                  "limit": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "query result (rows + columns + scanned_rows + took_ms + cache_hit)",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "query result (rows + columns + scanned_rows + took_ms + cache_hit)"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query/search_around": {
      "post": {
        "summary": "前后 N 条上下文（spec §24.1）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "event_timestamp_us",
                  "stream",
                  "stream_type"
                ],
                "properties": {
                  "event_timestamp_us": {
                    "type": "integer"
                  },
                  "event_fingerprint": {
                    "type": "string"
                  },
                  "stream": {
                    "type": "string"
                  },
                  "stream_type": {
                    "type": "string"
                  },
                  "before": {
                    "type": "integer",
                    "default": 50
                  },
                  "after": {
                    "type": "integer",
                    "default": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "before + after blocks",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "before + after blocks"
                }
              }
            }
          }
        }
      }
    },
