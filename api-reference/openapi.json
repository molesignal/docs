{
  "openapi": "3.0.3",
  "info": {
    "title": "MoleSignal API",
    "version": "1.0.0",
    "description": "MoleSignal 是可观测平台核心引擎。所有 endpoint 默认走 `Authorization: Bearer <jwt>` 鉴权；\n`/api/v1/healthz` / `/api/v1/auth/login` / `/metrics` 在白名单内免鉴权。\n\n错误统一返 `{ \"error\": \"<message>\" }` body；状态码：\n- 400 invalid argument\n- 401 unauthorized (token 校验失败)\n- 403 forbidden (role / license 不足)\n- 404 not found / 跨 org lookup\n- 409 conflict (unique 约束 / 状态冲突)\n- 413 quota exhausted\n- 429 rate limited\n"
  },
  "servers": [
    {
      "url": "https://molesignal.example.com"
    },
    {
      "url": "http://localhost:5080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "IngestResult": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "rejected": {
            "type": "integer"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "summary": "Liveness + readiness probe",
        "security": [],
        "responses": {
          "200": {
            "description": "ready",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "ready"
                }
              }
            }
          },
          "503": {
            "description": "degraded (ingester replay / object_store probe failing)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "degraded (ingester replay / object_store probe failing)"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus exposition",
        "security": [],
        "responses": {
          "200": {
            "description": "text/plain; version=0.0.4",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Email + password login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "org_id": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/schemas/Error"
          }
        }
      }
    },
    "/api/v1/auth/sso/login": {
      "get": {
        "summary": "SSO OIDC login redirect (license-gated)",
        "responses": {
          "302": {
            "description": "redirect to IdP /authorize",
            "content": {
              "application/json": {
                "example": {
                  "status": 302,
                  "message": "redirect to IdP /authorize"
                }
              }
            }
          },
          "403": {
            "description": "sso feature not licensed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "sso feature not licensed"
                }
              }
            }
          }
        }
      }
    },
