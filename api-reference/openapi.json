      "get": {
        "summary": "SSO OIDC callback (license-gated)",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JWT issued",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "JWT issued"
                }
              }
            }
          },
          "401": {
            "description": "IdP error / id_token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "IdP error / id_token invalid"
                }
              }
            }
          },
          "403": {
            "description": "sso feature not licensed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "sso feature not licensed"
                }
              }
            }
          }
        }
      }
    },
