# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Diagram build tooling and editable Excalidraw sources (dev-only). Anchor the
# diagrams ignore to the repo root with a leading slash — an unanchored
# `diagrams/` also matches nested dirs like `public/diagrams/` (the rendered PNGs
# the docs actually embed), which silently excluded them from the deploy.
scripts/
/diagrams/
*.excalidraw
